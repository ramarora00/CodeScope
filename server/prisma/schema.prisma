// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Repo {
  id        String   @id @default(uuid())
  name      String
  url       String?
  localPath String
  status          String   @default("ready") // cloning, indexing, ready, error
  understandingHash String?
  repositorySummary String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  files           File[]
}

model File {
  id          String   @id @default(uuid())
  path        String
  content     String?
  contentHash String?  // SHA-256 hash for incremental reindex delta detection
  language    String?
  metadata    String?
  repoId      String
  repo        Repo     @relation(fields: [repoId], references: [id], onDelete: Cascade)
  symbols     Symbol[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([repoId, path])
}

model Symbol {
  id            String   @id @default(uuid())
  name          String
  qualifiedName String   // e.g. "src/auth/authService.js#login"
  type          String   // function, class, interface, route, external_service
  isExternal    Boolean  @default(false)
  lineStart     Int?
  lineEnd       Int?
  fileId        String
  file          File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  repoId        String
  
  // Relationships for Call Graph
  callers      SymbolRelationship[] @relation("CalledSymbol")
  callees      SymbolRelationship[] @relation("CallerSymbol")

  createdAt DateTime @default(now())

  @@index([repoId, qualifiedName])
  @@index([repoId, name])
}

model SymbolRelationship {
  id              String @id @default(uuid())
  callerId        String
  calleeId        String
  relationship    String // calls, imports, exports, reexports, extends, uses
  executionOrder  Int?   // middleware chain ordering (0, 1, 2...)
  
  caller          Symbol @relation("CallerSymbol", fields: [callerId], references: [id], onDelete: Cascade)
  callee          Symbol @relation("CalledSymbol", fields: [calleeId], references: [id], onDelete: Cascade)

  confidence       Float  @default(1.0)
  resolutionMethod String @default("unknown")

  @@unique([callerId, calleeId, relationship])
}
